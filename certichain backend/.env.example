# LiveKit project used by the CertiChain API and standalone voice agent.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=certichain-agent
LIVEKIT_SIP_TRUNK_ID=your_livekit_outbound_sip_trunk_id

# Voice-agent provider keys. Keep these server-side; never use VITE_ variables.
DEEPGRAM_API_KEY=your_deepgram_api_key
GOOGLE_API_KEY=your_google_api_key
MURF_API_KEY=your_murf_api_key
