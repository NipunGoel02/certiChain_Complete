# LiveKit project used by the CertiChain API and standalone voice agent.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=certichain-agent
LIVEKIT_SIP_TRUNK_ID=your_livekit_outbound_sip_trunk_id

# Voice-agent provider keys. Keep these server-side; never use VITE_ variables.
DEEPGRAM_API_KEY=your_deepgram_api_key
GOOGLE_API_KEY=your_google_api_key
MURF_API_KEY=your_murf_api_key

# ProofCall callback/reporting (keep server-side; use a long random secret).
# The voice worker reads this same backend .env file. For a remote worker, this
# must be the publicly reachable base URL of the CertiChain Express API.
ASSESSMENT_CALLBACK_SECRET=replace_with_a_long_random_secret
CERTICHAIN_API_URL=http://localhost:5000
ASSESSMENT_REPORT_MODEL=gemini-3.5-flash-lite

# Optional Sepolia JSON-RPC endpoint for verifying ProofCall report hash anchors.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
